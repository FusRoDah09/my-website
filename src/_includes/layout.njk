<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Personal website of Darpan Choudhary.">
    <title>{{ title or "Darpan Choudhary" }}</title>
    <link rel="preload" href="/css/style.css" as="style">
    <link rel="stylesheet" href="/css/style.css">
    {% if pageStyles %}<link rel="stylesheet" href="{{ pageStyles }}">{% endif %}
</head>
<body>
    <nav style="display: flex; align-items: center; gap: 10px;">
        <img src="/images/concac.webp" width="50" height="30" alt="concac" decoding="async"/>
        <div>
            <a href="/">Home</a> |
            <a href="/bio/">Bio</a> |
            <a href="/writings/">Writings</a> |
            <a href="/books/">Books</a> |
            <a href="/investments/">Investments</a> |
            <a href="/cats/">Cats</a> |
            <a href="/links/">Links</a>
        </div>
    </nav>

    <main>
        {{ content | safe }}
    </main>
    
    <footer>
        {% if showHitCounter %}
        <!-- BEGIN HIT-COUNTER.NET CODE -->
        <img
            class="hit-counter"
            src="https://www.hit-counter.net/counter.php?action=count&amp;style=zxnum8&amp;padding=6&amp;id=darpanchoudhary.com"
            alt="Hit counter"
            decoding="async"
            data-no-lazy
        />
        <!-- END HIT-COUNTER.NET CODE -->
        {% endif %}
        <p>&copy; Darpan Choudhary | Built with <a href="https://www.11ty.dev/">11ty</a></p>
    </footer>
</body>
</html>
